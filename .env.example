# ─── Copy to .env and fill in ────────────────────────────────────────────────
# docker compose reads this file automatically from the project root.

# ── LLM model ────────────────────────────────────────────────────────────────
# llama3.2:3b  — 2 GB RAM, 15-30 tok/s on CPU (recommended for this VM)
# llama3.1:8b  — 5 GB RAM, 8-12 tok/s on CPU
# mistral:7b   — 4 GB RAM, similar speed
OLLAMA_MODEL=llama3.2:3b

# ── Tenant ────────────────────────────────────────────────────────────────────
SEARCHLY_TENANT=greyorange

# ── SSH key for kubectl bastion access ───────────────────────────────────────
# Path to the private key that can reach your k8s bastions.
# The warehouse-agent uses this to run kubectl commands live.
SSH_KEY_PATH=~/.ssh/id_rsa

# ── Auth (tenant isolation) ───────────────────────────────────────────────────
# false = open access (good for internal dev/staging)
# true  = API key required; per-customer ACL enforced
AUTH_ENABLED=false

# Fixed admin API key (optional — if blank, one is auto-generated on first start
# and printed to: docker compose logs warehouse-agent | grep "GENERATED ADMIN")
# Generate a good key: python3 -c "import secrets; print('sk-go-'+secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ─── After enabling auth, create per-customer keys: ──────────────────────────
# 1. Get admin key:  docker compose logs warehouse-agent | grep "GENERATED ADMIN"
# 2. Create scoped key:
#    curl -X POST http://localhost:8084/api/v1/auth/keys \
#      -H "X-API-Key: <admin-key>" \
#      -H "Content-Type: application/json" \
#      -d '{"name":"Sams Club ATL ops","allowed_customers":["sams-club-atlanta"]}'
# 3. Give the returned key to the customer team — they can only see their data.
