FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY common/pom.xml common/
COPY search-api/pom.xml search-api/
COPY indexer/pom.xml indexer/
COPY gateway/pom.xml gateway/
RUN mvn -B -q -pl gateway -am dependency:go-offline || true
COPY gateway/src gateway/src
RUN mvn -B -pl gateway -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd -r app && useradd -r -g app app
COPY --from=build /workspace/gateway/target/gateway.jar /app/app.jar
USER app
EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/app.jar"]
